{
  "name": "create-typescript-npm-library",
  "description": "Simple typescript app with vitest to create a npm library with types",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "npm run build && npm run start:prod",
    "start:prod": "cd debug && npm run start",
    "build": "tsc && tsc-alias",
    "fix": "npm run lint && npm run format",
    "lint": "eslint src --ext .ts --fix",
    "lint:check": "eslint src --ext .ts",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pub": "npm run build && npm version patch && npm publish"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "~1.3.26",
    "eslint": "^8.30.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TheSmartMonkey/create-typescript-npm-library/issues"
  },
  "homepage": "https://github.com/TheSmartMonkey/create-typescript-npm-library#readme",
  "keywords": [
    "npm",
    "library",
    "template",
    "typescript"
  ]
}
