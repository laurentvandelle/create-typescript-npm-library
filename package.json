{
  "name": "create-typescript-npm-library",
  "description": "Simple typescript app with vitest to create a npm library with types",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "npm run build && npm run start:prod",
    "start:prod": "cd debug && npm run start",
    "build": "tsc && tsc-alias",
    "lint": "eslint --flag unstable_native_nodejs_ts_config src --fix",
    "lint:check": "eslint --flag unstable_native_nodejs_ts_config src",
    "test": "vitest run",
    "test:watch": "vitest",
    "pub": "npm run build && npm version patch && npm publish",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/eslint-plugin": "~1.3.26",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TheSmartMonkey/create-typescript-npm-library/issues"
  },
  "homepage": "https://github.com/TheSmartMonkey/create-typescript-npm-library#readme",
  "keywords": [
    "npm",
    "library",
    "template",
    "typescript"
  ],
  "engines": {
    "node": ">=24"
  }
}
